            superior_jerarquico: { help: 'Nombre del puesto al que reporta directamente.', example: 'Dirección General' },
            unidad_administrativa: { help: 'Área organizacional donde está adscrito el puesto.', example: 'Gerencia de Operaciones' },
            tipo_funciones: { help: 'Clasificación principal de las tareas del puesto.', example: 'Administrativas' },
            puestos_reportan: { help: 'Anota los puestos que reportan directamente a esta posición.', example: 'Analista de compras; auxiliar administrativo' },
            personas_directas: { help: 'Número de personas que le reportan sin intermediarios.', example: '4' },
            personas_indirectas: { help: 'Número de personas que dependen del puesto a través de otros mandos.', example: '8' },
            objetivo_puesto: { help: 'Resume para qué existe el puesto y cuál es su principal resultado esperado.', example: 'Coordinar las operaciones para cumplir las metas de producción.' },
            relaciones_aplican: { help: 'Indica si las relaciones con áreas, clientes, proveedores o comités son parte real del trabajo. Si no lo son, deja la opción No es necesario.', example: 'Sí, se coordina con proveedores cada semana' },
            clientes_internos: { help: 'Áreas o personas de la misma organización que reciben el resultado de este puesto.', example: 'Compras y Finanzas' },
            proveedores_internos: { help: 'Áreas o personas internas que entregan información, materiales o servicios a este puesto.', example: 'Almacén' },
            para_que_se_relaciona_int: { help: 'Explica brevemente para qué se mantiene la relación interna.', example: 'Validar existencias y coordinar resurtidos' },
            'comite_int_nombre[]': { help: 'Nombre del comité interno en el que participa el puesto.', example: 'Comité de Seguridad e Higiene' },
            'comite_int_objeto[]': { help: 'Propósito principal del comité interno.', example: 'Prevenir accidentes en las instalaciones' },
            'comite_int_funcion[]': { help: 'Responsabilidad o participación que tiene el puesto en el comité.', example: 'Vocal; revisa y da seguimiento a incidentes' },
            'comite_int_periodicidad[]': { help: 'Cada cuánto se reúne el comité.', example: 'Mensual' },
            clientes_externos: { help: 'Personas u organizaciones externas que reciben los resultados del puesto.', example: 'Clientes mayoristas' },
            proveedores_externos: { help: 'Organizaciones externas que suministran bienes o servicios al puesto.', example: 'Proveedor de transporte' },
            para_que_se_relaciona_ext: { help: 'Explica el propósito de la relación con personas u organizaciones externas.', example: 'Coordinar fechas de entrega y resolver incidencias' },
            'comite_ext_nombre[]': { help: 'Nombre del comité externo en el que participa el puesto.', example: 'Comité local de protección civil' },
            'comite_ext_objeto[]': { help: 'Propósito principal del comité externo.', example: 'Coordinar acciones de prevención entre organizaciones' },
            'comite_ext_funcion[]': { help: 'Responsabilidad del puesto dentro del comité externo.', example: 'Representar a la empresa y compartir avances' },
            'comite_ext_periodicidad[]': { help: 'Cada cuánto se reúne el comité externo.', example: 'Trimestral' },
            decisiones_sin_consultar: { help: 'Decisiones que puede tomar por sí mismo dentro de sus atribuciones.', example: 'Reasignar prioridades diarias de surtido' },
            objetivo_decisiones_sin_consultar: { help: 'Resultado que busca con las decisiones autónomas descritas.', example: 'Mantener la continuidad de la operación' },
            decisiones_conjuntas: { help: 'Decisiones que requieren acuerdo con otra jefatura o área.', example: 'Aprobar el presupuesto anual con Dirección' },
            objetivo_decisiones_conjuntas: { help: 'Resultado esperado de las decisiones compartidas.', example: 'Alinear el gasto con las metas de la empresa' },
            servicio_ciudadano: { help: 'Señala si el puesto atiende o brinda orientación directa al público.', example: 'SI, si atiende personas externas' },
            declaracion_patrimonial: { help: 'Indica si por las responsabilidades del puesto se debe presentar esta declaración.', example: 'SI, cuando corresponde por normativa' },
            nivel_academico: { help: 'Nivel de estudios mínimo requerido para desempeñar el puesto.', example: 'Licenciatura' },
            grado_avance: { help: 'Situación académica que se exige para el nivel seleccionado.', example: 'Titulado' },
            profesiones_areas: { help: 'Carreras o conocimientos relacionados con las funciones del puesto.', example: 'Administración, Ingeniería Industrial o afín' },
            'idioma_nombre[]': { help: 'Idioma que se necesita para realizar las funciones.', example: 'Inglés' },
            'idioma_nivel[]': { help: 'Nivel de comprensión y comunicación requerido en ese idioma.', example: 'Intermedio B2' },
            programas_computo: { help: 'Sistemas, programas o herramientas que se usan en el puesto.', example: 'Excel avanzado y SAP' },
            areas_experiencia: { help: 'Sectores o actividades laborales donde se requiere experiencia previa.', example: 'Logística y control de inventarios' },
            anos_experiencia_deseable: { help: 'Años de experiencia recomendables, pero no obligatorios.', example: '2' },
            anos_experiencia_indispensable: { help: 'Años de experiencia mínimos que sí son requisito.', example: '4' },
            disponibilidad_viajar: { help: 'Indica si las funciones requieren viajar fuera del lugar habitual de trabajo.', example: 'SI, para visitas mensuales a sucursales' },
            cambio_residencia: { help: 'Indica si el puesto puede requerir mudarse a otra ciudad.', example: 'NO' },
            horario_trabajo: { help: 'Horario habitual o esquema de jornada del puesto.', example: 'Lunes a viernes, 9:00 a 18:00' },
            periodos_especiales: { help: 'Temporadas o fechas en que se requiere disponibilidad adicional.', example: 'Cierre anual de inventarios en diciembre' },
            'funcion_num[]': { help: 'Número consecutivo para identificar la función.', example: '1' },
            'funcion_descripcion[]': { help: 'Describe una actividad relevante que realiza el puesto y su resultado.', example: 'Coordinar el cierre mensual de inventarios.' },
            'competencia_nombre[]': { help: 'Habilidad o conducta necesaria para realizar el trabajo.', example: 'Liderazgo' },
            'competencia_nivel[]': { help: 'Grado de dominio requerido para esa competencia.', example: 'Avanzado' },
            'competencia_descripcion[]': { help: 'Conducta observable que demuestra la competencia en el puesto.', example: 'Organiza al equipo y da seguimiento a compromisos.' },
            innovacion_opciones: { help: 'Selecciona las acciones de innovación o mejora que forman parte del puesto.', example: 'Aplicación y Fomento' }
        };

        function createHelpTip(text) {
            const tip = document.createElement('span');
            tip.className = 'help-tip';
            tip.tabIndex = 0;
            tip.setAttribute('aria-label', `Ayuda: ${text}`);
            tip.title = text;
            tip.dataset.tip = text;
            tip.textContent = '?';
            return tip;
        }

        function enhanceFields(root) {
            root.querySelectorAll('input[name], textarea[name], select[name]').forEach((field) => {
                const guide = fieldGuides[field.name];
                if (!guide || field.type === 'checkbox') return;

                field.title = guide.help;
                const label = field.id ? document.querySelector(`label[for="${CSS.escape(field.id)}"]`) : null;
                const header = field.closest('td')?.closest('table')?.tHead?.rows[0]?.cells[field.closest('td').cellIndex];
                const helpTarget = label || header;
                if (helpTarget && !helpTarget.querySelector('.help-tip')) {
                    helpTarget.append(createHelpTip(guide.help));
                }

                if (!field.nextElementSibling?.classList.contains('field-example')) {
                    const example = document.createElement('small');
                    example.className = 'field-example';
                    example.textContent = `Ejemplo: ${guide.example}`;
                    field.after(example);
                }
            });
        }

        enhanceFields(document);
        const innovationLabel = document.querySelector('.field-label');
        const innovationGuide = fieldGuides.innovacion_opciones;
        if (innovationLabel && !innovationLabel.querySelector('.help-tip')) {
            innovationLabel.append(createHelpTip(innovationGuide.help));
        }

        const relationsToggle = document.getElementById('relaciones_aplican');
        const relationsDetails = document.getElementById('relaciones-detalles');
        function updateRelationsVisibility() {
            const showDetails = relationsToggle.value === 'si';
            relationsDetails.hidden = !showDetails;
            relationsDetails.querySelectorAll('input, textarea, select').forEach((field) => {
                field.disabled = !showDetails;
            });
        }
        relationsToggle.addEventListener('change', updateRelationsVisibility);
        updateRelationsVisibility();
    </script>
</body>
</html>