<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        @page { size: A4; margin: 14mm 12mm; }
        * { box-sizing: border-box; }
        body { margin: 0; color: #242321; font: 10px/1.42 Arial, sans-serif; }
        header { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 4px solid #a9bd62; }
        .brand { color: #5c1428; font-size: 17px; font-weight: 700; }
        .document-title { flex: 1; text-align: right; font-size: 15px; font-weight: 700; }
        h2 { margin: 16px 0 7px; padding: 6px 8px; background: #5c1428; color: #fff; font-size: 12px; break-after: avoid; }
        h3 { margin: 12px 0 5px; color: #5c1428; font-size: 10.5px; break-after: avoid; }
        table { width: 100%; margin: 0 0 9px; border-collapse: collapse; table-layout: fixed; }
        th, td { padding: 5px 6px; border: 1px solid #c9c5bd; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
        th { background: #eeede8; font-size: 9px; }
        .label { width: 23%; background: #f6f5f2; font-weight: 700; }
        .pair .label { width: 18%; }
        .pair td:not(.label) { width: 32%; }
        .answer { white-space: pre-wrap; }
        tr { break-inside: avoid; }
        .empty { color: #777; font-style: italic; }
    </style>
</head>
<body>
    <header>
        <div class="brand">Fogatotas S.A de C.V</div>
        <div class="document-title">DESCRIPCIÓN Y PERFIL DEL PUESTO</div>
    </header>

    <h2>1. Encabezado e identificación general</h2>
    <table class="pair">
        <tr><td class="label">Código del puesto</td><td>{{ codigo_puesto }}</td><td class="label">Nivel tabular</td><td>{{ nivel_tabular }}</td></tr>
        <tr><td class="label">Denominación</td><td colspan="3">{{ denominacion_puesto }}</td></tr>
        <tr><td class="label">Característica ocupacional</td><td>{{ caracteristica_ocupacional }}</td><td class="label">Institución</td><td>{{ institucion }}</td></tr>
    </table>

    <h2>2. Datos generales e identificación</h2>
    <table class="pair">
        <tr><td class="label">Rama de cargo</td><td>{{ rama_cargo }}</td><td class="label">Nombramiento</td><td>{{ nombramiento }}</td></tr>
        <tr><td class="label">Superior jerárquico</td><td>{{ superior_jerarquico }}</td><td class="label">Unidad administrativa</td><td>{{ unidad_administrativa }}</td></tr>
        <tr><td class="label">Personas directas a cargo</td><td>{{ personas_directas }}</td><td class="label">Personas indirectas a cargo</td><td>{{ personas_indirectas }}</td></tr>
        <tr><td class="label">Tipo de funciones</td><td>{{ tipo_funciones }}</td><td class="label">Puestos que le reportan</td><td class="answer">{{ puestos_reportan }}</td></tr>
    </table>

    <h2>3. Objetivo general del puesto</h2>
    <table><tr><td class="answer">{{ objetivo_puesto }}</td></tr></table>

    <h2>4. Funciones</h2>
    <table>
        <thead><tr><th style="width: 16%">Número</th><th>Descripción de la función</th></tr></thead>
        <tbody>
            {% for fila in funciones %}<tr><td>{{ fila.numero }}</td><td class="answer">{{ fila.descripcion }}</td></tr>
            {% else %}<tr><td colspan="2" class="empty">Sin funciones capturadas</td></tr>{% endfor %}
        </tbody>
    </table>

    <h2>5. Relaciones internas y externas</h2>
    <h3>Relaciones internas</h3>
    <table class="pair">
        <tr><td class="label">Clientes internos</td><td class="answer">{{ clientes_internos }}</td><td class="label">Proveedores internos</td><td class="answer">{{ proveedores_internos }}</td></tr>
        <tr><td class="label">Motivo de relación</td><td colspan="3" class="answer">{{ para_que_se_relaciona_int }}</td></tr>
    </table>
    <h3>Comités internos y juntas formales</h3>
    <table>
        <thead><tr><th>Nombre</th><th>Objeto</th><th>Función desempeñada</th><th>Periodicidad</th></tr></thead>
        <tbody>
            {% for fila in comites_internos %}<tr><td>{{ fila.nombre }}</td><td>{{ fila.objeto }}</td><td>{{ fila.funcion }}</td><td>{{ fila.periodicidad }}</td></tr>
            {% else %}<tr><td colspan="4" class="empty">Sin comités internos capturados</td></tr>{% endfor %}
        </tbody>
    </table>
    <h3>Relaciones externas</h3>
    <table class="pair">
        <tr><td class="label">Clientes externos</td><td class="answer">{{ clientes_externos }}</td><td class="label">Proveedores externos</td><td class="answer">{{ proveedores_externos }}</td></tr>
        <tr><td class="label">Motivo de relación</td><td colspan="3" class="answer">{{ para_que_se_relaciona_ext }}</td></tr>
    </table>
    <h3>Comités externos</h3>
    <table>
        <thead><tr><th>Nombre</th><th>Objeto</th><th>Función desempeñada</th><th>Periodicidad</th></tr></thead>
        <tbody>
            {% for fila in comites_externos %}<tr><td>{{ fila.nombre }}</td><td>{{ fila.objeto }}</td><td>{{ fila.funcion }}</td><td>{{ fila.periodicidad }}</td></tr>
            {% else %}<tr><td colspan="4" class="empty">Sin comités externos capturados</td></tr>{% endfor %}
        </tbody>
    </table>

    <h2>6. Aspectos relevantes del puesto</h2>
    <h3>Autoridad y facultades</h3>
    <table class="pair">
        <tr><td class="label">Decisiones sin consultar</td><td class="answer">{{ decisiones_sin_consultar }}</td><td class="label">Objetivo</td><td class="answer">{{ objetivo_decisiones_sin_consultar }}</td></tr>
        <tr><td class="label">Decisiones conjuntas</td><td class="answer">{{ decisiones_conjuntas }}</td><td class="label">Objetivo</td><td class="answer">{{ objetivo_decisiones_conjuntas }}</td></tr>
    </table>
    <h3>Innovación, optimización y contribución</h3>
    <table><tr><td>{{ innovacion_opciones|join(', ') if innovacion_opciones else 'Sin opciones seleccionadas' }}</td></tr></table>
    <h3>Servicio al ciudadano y declaración patrimonial</h3>
    <table class="pair">
        <tr><td class="label">Brinda servicio al ciudadano</td><td>{{ servicio_ciudadano }}</td><td class="label">Declaración patrimonial</td><td>{{ declaracion_patrimonial }}</td></tr>
    </table>

    <h2>7. Perfil del puesto</h2>
    <h3>Escolaridad y áreas de conocimiento</h3>
    <table class="pair">
        <tr><td class="label">Nivel académico</td><td>{{ nivel_academico }}</td><td class="label">Grado de avance</td><td>{{ grado_avance }}</td></tr>
        <tr><td class="label">Profesión o áreas de conocimiento</td><td colspan="3" class="answer">{{ profesiones_areas }}</td></tr>
    </table>
    <h3>Idiomas</h3>
    <table>
        <thead><tr><th>Idioma</th><th>Nivel de dominio</th></tr></thead>
        <tbody>
            {% for fila in idiomas %}<tr><td>{{ fila.nombre }}</td><td>{{ fila.nivel }}</td></tr>
            {% else %}<tr><td colspan="2" class="empty">Sin idiomas capturados</td></tr>{% endfor %}
        </tbody>
    </table>
    <table><tr><td class="label">Programas y herramientas</td><td class="answer">{{ programas_computo }}</td></tr></table>

    <h3>Experiencia laboral</h3>
    <table class="pair">
        <tr><td class="label">Áreas de experiencia</td><td class="answer">{{ areas_experiencia }}</td><td class="label">Años deseables / indispensables</td><td>{{ anos_experiencia_deseable }} / {{ anos_experiencia_indispensable }}</td></tr>
    </table>
    <h3>Requerimientos específicos</h3>
    <table class="pair">
        <tr><td class="label">Disponibilidad para viajar</td><td>{{ disponibilidad_viajar }}</td><td class="label">Cambio de residencia</td><td>{{ cambio_residencia }}</td></tr>
        <tr><td class="label">Horario de trabajo</td><td class="answer">{{ horario_trabajo }}</td><td class="label">Periodos especiales</td><td class="answer">{{ periodos_especiales }}</td></tr>
    </table>
    <h3>Competencias requeridas</h3>
    <table>
        <thead><tr><th>Competencia</th><th>Nivel</th><th>Descripción funcional</th></tr></thead>
        <tbody>
            {% for fila in competencias %}<tr><td>{{ fila.nombre }}</td><td>{{ fila.nivel }}</td><td class="answer">{{ fila.descripcion }}</td></tr>
            {% else %}<tr><td colspan="3" class="empty">Sin competencias capturadas</td></tr>{% endfor %}
        </tbody>
    </table>
</body>
</html>